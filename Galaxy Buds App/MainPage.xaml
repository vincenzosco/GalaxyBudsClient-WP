<phone:PhoneApplicationPage
    x:Class="Galaxy_Buds_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="TitlePanel" Grid.Row="0" Margin="12,17,0,12">
            <TextBlock x:Name="ApplicationTitleText" Text="{Binding Path=LocalizedResources.ApplicationTitle, Source={StaticResource LocalizedStrings}}"
                       Style="{StaticResource PhoneTextNormalStyle}" Margin="12,0"/>
            <TextBlock x:Name="PageTitleText" Text="{Binding Path=LocalizedResources.DevicesPageTitle, Source={StaticResource LocalizedStrings}}"
                       Margin="9,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="12,0,12,0">
            <StackPanel>
                <!-- Device list section -->
                <TextBlock x:Name="SectionDevices" Text="{Binding Path=LocalizedResources.SectionDevices, Source={StaticResource LocalizedStrings}}"
                           Style="{StaticResource PhoneTextSubtleStyle}" Margin="0,0,0,8"/>
                <ListBox x:Name="DeviceListBox" SelectionChanged="DeviceListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PhoneTextNormalStyle}"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource PhoneTextSubtleStyle}" FontSize="{StaticResource PhoneFontSizeSmall}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Connection status -->
                <TextBlock x:Name="ConnectionStatusText" Text="{Binding Path=LocalizedResources.NotConnected, Source={StaticResource LocalizedStrings}}"
                           Style="{StaticResource PhoneTextSubtleStyle}" Margin="0,16,0,4"/>

                <!-- Action buttons -->
                <Button x:Name="ScanButton" Content="{Binding Path=LocalizedResources.ScanForDevices, Source={StaticResource LocalizedStrings}}"
                        Click="ScanButton_Click" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                <Button x:Name="ConnectButton" Content="{Binding Path=LocalizedResources.Connect, Source={StaticResource LocalizedStrings}}"
                        Click="ConnectButton_Click" Margin="0,4,0,0" HorizontalAlignment="Stretch" IsEnabled="False"/>
                <Button x:Name="DisconnectButton" Content="{Binding Path=LocalizedResources.Disconnect, Source={StaticResource LocalizedStrings}}"
                        Click="DisconnectButton_Click" Margin="0,4,0,0" HorizontalAlignment="Stretch" IsEnabled="False"/>

                <!-- Overview section (visible after connection) -->
                <StackPanel x:Name="OverviewPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock x:Name="SectionOverview" Text="{Binding Path=LocalizedResources.SectionOverview, Source={StaticResource LocalizedStrings}}"
                               Style="{StaticResource PhoneTextSubtleStyle}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Path=LocalizedResources.Left, Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource PhoneTextSubtleStyle}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="BatteryLeftText" Text="--" Style="{StaticResource PhoneTextLargeStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Path=LocalizedResources.Right, Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource PhoneTextSubtleStyle}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="BatteryRightText" Text="--" Style="{StaticResource PhoneTextLargeStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Sound controls section -->
                <StackPanel x:Name="SoundPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock Text="{Binding Path=LocalizedResources.SectionSound, Source={StaticResource LocalizedStrings}}"
                               Style="{StaticResource PhoneTextSubtleStyle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Path=LocalizedResources.Equalizer, Source={StaticResource LocalizedStrings}}"
                               Style="{StaticResource PhoneTextNormalStyle}" Margin="0,4,0,4"/>
                    <ListBox x:Name="EqualizerListBox" SelectionChanged="EqualizerListBox_SelectionChanged">
                        <ListBoxItem Content="{Binding Path=LocalizedResources.EqBassBoost, Source={StaticResource LocalizedStrings}}"/>
                        <ListBoxItem Content="{Binding Path=LocalizedResources.EqSoft, Source={StaticResource LocalizedStrings}}"/>
                        <ListBoxItem Content="{Binding Path=LocalizedResources.EqDynamic, Source={StaticResource LocalizedStrings}}"/>
                        <ListBoxItem Content="{Binding Path=LocalizedResources.EqClear, Source={StaticResource LocalizedStrings}}"/>
                        <ListBoxItem Content="{Binding Path=LocalizedResources.EqTrebleBoost, Source={StaticResource LocalizedStrings}}"/>
                    </ListBox>
                </StackPanel>

                <!-- Controls section -->
                <StackPanel x:Name="ControlsPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock Text="{Binding Path=LocalizedResources.SectionControls, Source={StaticResource LocalizedStrings}}"
                               Style="{StaticResource PhoneTextSubtleStyle}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="TouchpadLockCheck" Content="{Binding Path=LocalizedResources.TouchpadLock, Source={StaticResource LocalizedStrings}}"
                              Checked="TouchpadLockCheck_Changed" Unchecked="TouchpadLockCheck_Changed"/>
                </StackPanel>

                <!-- Device tools section -->
                <StackPanel x:Name="ToolsPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock Text="{Binding Path=LocalizedResources.SectionTools, Source={StaticResource LocalizedStrings}}"
                               Style="{StaticResource PhoneTextSubtleStyle}" Margin="0,0,0,8"/>
                    <Button x:Name="FindMyEarbudsButton" Content="{Binding Path=LocalizedResources.FindMyEarbuds, Source={StaticResource LocalizedStrings}}"
                            Click="FindMyEarbudsButton_Click" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Settings / About -->
                <TextBlock Text="{Binding Path=LocalizedResources.SectionAbout, Source={StaticResource LocalizedStrings}}"
                           Style="{StaticResource PhoneTextSubtleStyle}" Margin="0,16,0,4"/>
                <TextBlock Text="{Binding Path=LocalizedResources.UnofficialNotice, Source={StaticResource LocalizedStrings}}"
                           Style="{StaticResource PhoneTextSubtleStyle}" TextWrapping="Wrap" FontSize="{StaticResource PhoneFontSizeSmall}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>
